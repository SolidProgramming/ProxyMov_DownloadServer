@implements IDisposable

@code {
    private Lang LangText = new();

    private HxModal DownloadPathModal = new();
    private HxModal CaptchaModal = new();

    private List<ActiveDownloadModel> ActiveDownloads = [];
    private ConverterState ConverterState = ConverterState.Idle;
    private CronJobState CronJobState = CronJobState.WaitForNextCycle;
    private int StopAfterDownloadCount { get; set; } = 0;

    private bool CheckDownloadsButtonEnabled { get; set; }
    private bool CheckDownloadsButtonSpinner { get; set; }

    private bool EditConverterSettingsButtonEnabled { get; set; } = true;

    private bool StopConverterButtonEnabled { get; set; }

    private DateTime? NextCronJobCycle;
    private TimeOnly NextCronJobCyleTime;
    private Timer? TmNextCycle;
    private TimeSpan? TimeUntilCycle;
    private string? TimeUntilCycleText;

    private int DownloadQueCount;
    private int LanguageDownloadCount;

    // Without active downloads one empty placeholder row is shown.
    private static readonly ActiveDownloadModel?[] PlaceholderDownloads = [null];
    private IReadOnlyList<ActiveDownloadModel?> DisplayedDownloads => ActiveDownloads.Count > 0 ? ActiveDownloads : PlaceholderDownloads;

    private SettingsModel Settings = new();
    private bool ShowDownloadPathError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        LangText = await I18nText.GetTextTableAsync<Lang>(this);
    }

    protected override async void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Settings = SettingsHelper.ReadSettings<SettingsModel>() ?? new();

            if (Settings is not null && string.IsNullOrEmpty(Settings.DownloadPath))
            {
                await DownloadPathModal.ShowAsync();
                return;
            }

            ConverterState = ConverterService.GetConverterState();
            ActiveDownloads = ConverterService.GetActiveDownloads();

            RuntimeState.StateChanged += CronJobEvent;
            RuntimeState.ErrorOccurred += CronJobErrorEvent;
            RuntimeState.DownloadsChanged += CronJobDownloads;
            ConverterService.ConvertProgressChanged += Converter_ConvertProgressChanged;
            ConverterService.ConverterStateChanged += Converter_ConverterStateChanged;

            if (TmNextCycle is null)
            {
                TmNextCycle = new Timer
                {
                    AutoReset = true,
                    Interval = 1000
                };

                TmNextCycle.Elapsed += RefreshCycleTime;
            }

            if (!TmNextCycle.Enabled)
            {
                TmNextCycle.Start();
            }

            SetDownloadCounters();
            HandleCronJobState();

            if (Environment.GetEnvironmentVariable("DOTNET_RUNNING_IN_CONTAINER") != "true")
            {
                Version version = typeof(Program).Assembly.GetName().Version ?? new Version(1, 0, 0);
                string assemblyVersion = version.ToString();
                await UpdateService.CheckForUpdates(assemblyVersion);
            }
        }
    }

    private void RefreshCycleTime(object? source, ElapsedEventArgs e)
    {
        if (RuntimeState.NextRun is null)
        {
            return;
        }

        NextCronJobCycle = RuntimeState.NextRun.Value;
        NextCronJobCyleTime = TimeOnly.FromDateTime(NextCronJobCycle.Value);

        if (NextCronJobCycle < DateTime.UtcNow.ToLocalTime().ToLocalTime())
        {
            TimeUntilCycle = new TimeSpan(0, 0, 0);
        }
        else
        {
            TimeUntilCycle = NextCronJobCycle?.Subtract(DateTime.UtcNow.ToLocalTime().ToLocalTime());
        }

        TimeUntilCycleText = "";

        if (TimeUntilCycle?.Hours > 0)
        {
            TimeUntilCycleText = $"{TimeUntilCycle:hh} {LangText["Hours"]}";
        }

        if (TimeUntilCycle?.Minutes > 0)
        {
            TimeUntilCycleText += $" {TimeUntilCycle:mm} {LangText["Minutes"]}";
        }

        TimeUntilCycleText += $" {TimeUntilCycle:ss} {LangText["Seconds"]}";

        InvokeAsync(() => StateHasChanged());
    }

    private void MoveToConverterSettings()
    {
        NavigationManager.NavigateTo(Routes.ConverterSettings);
    }

    private void Converter_ConvertProgressChanged(ActiveDownloadModel download)
    {
        ActiveDownloads = ConverterService.GetActiveDownloads();

        InvokeAsync(() => StateHasChanged());
    }

    private void CronJobDownloads(int downloadCount, int languageDownloadCount)
    {
        DownloadQueCount = downloadCount;
        LanguageDownloadCount = languageDownloadCount;

        InvokeAsync(() => StateHasChanged());
    }

    private void CronJobEvent(CronJobState jobState)
    {
        HandleCronJobState(jobState, true);
    }

    private void CronJobErrorEvent(MessageType messageType, string message)
    {
        CronJobLogger.LogInformation($"{DateTime.UtcNow.ToLocalTime()} | {message}");
        ToastService.AddMessage(message, messageType);
    }

    private void SetDownloadCounters()
    {
        DownloadQueCount = RuntimeState.DownloadCount;
        LanguageDownloadCount = RuntimeState.LanguageDownloadCount;
    }

    private void HandleCronJobState(CronJobState cronJobState = CronJobState.Undefined, bool fromEvent = false)
    {
        if (cronJobState == CronJobState.Undefined)
        {
            CronJobState = RuntimeState.CronJobState;
        }
        else
        {
            CronJobState = cronJobState;
        }

        ActiveDownloads = ConverterService.GetActiveDownloads();
        SetDownloadCounters();

        switch (CronJobState)
        {
            case CronJobState.WaitForNextCycle:
                CheckDownloadsButtonEnabled = true;
                CheckDownloadsButtonSpinner = false;
                StopConverterButtonEnabled = false;
                EditConverterSettingsButtonEnabled = true;
                break;

            case CronJobState.Running:
                CheckDownloadsButtonEnabled = false;
                CheckDownloadsButtonSpinner = false;
                StopConverterButtonEnabled = true;
                EditConverterSettingsButtonEnabled = false;
                break;

            case CronJobState.CheckingForDownloads:
                CheckDownloadsButtonEnabled = false;
                CheckDownloadsButtonSpinner = true;
                ToastService.AddMessage(InfoMessage.CheckingForDownloads, MessageType.Secondary);
                break;
            case CronJobState.Paused:
                NextCronJobCycle = null;
                break;
        }

        if (fromEvent)
        {
            InvokeAsync(() => StateHasChanged());
        }
        else
        {
            StateHasChanged();
        }
    }

    private void Converter_ConverterStateChanged(ConverterState state, EpisodeDownloadModel? episode)
    {
        if (state is not (ConverterState.Downloading or ConverterState.Idle)) return;

        ConverterState = state;
        ActiveDownloads = ConverterService.GetActiveDownloads();

        InvokeAsync(() => StateHasChanged());
    }

    private async Task CheckForDownloads()
    {
        if (QuartzService.IsCancelled())
        {
            await QuartzService.StartJob();
        }
        else
        {
            await CronJobService.CheckForNewDownloads();
        }
    }

    private async Task ContinueAfterCaptcha()
    {
        RuntimeState.SetPendingCaptchaUrl(null);
        await CheckForDownloads();
    }

    private async Task StopConverter()
    {
        await CronJobService.Abort();

        ConverterService.Abort();

        QuartzService.CancelJob();

        NextCronJobCycle = null;
        // await InvokeAsync(() => StateHasChanged());
    }

    private void SkipDownload(ActiveDownloadModel? download)
    {
        if (download is null || CronJobState != CronJobState.Running)
        {
            return;
        }

        ConverterService.Skip(download.Id);
    }

    private void OnDownloadSkipped(int newDownloadCount)
    {
        DownloadQueCount = newDownloadCount;
    }

    private string? GetAdjustedDownloadSpeed(ConvertProgressModel convertProgress)
    {
        if (convertProgress is null || convertProgress.KBytePerSecond <= 0)
        {
            return null;
        }

        string unit = "KB/s";
        double speed = convertProgress.KBytePerSecond;

        string speedFormatted = $"{speed:N0}";

        if (convertProgress.KBytePerSecond > 1024)
        {
            speed /= 1024;
            unit = "MB/s";

            speedFormatted = $"{speed:N2}";
        }

        return $"{speedFormatted} {unit}";
    }

    private async void SaveDownloadPath()
    {
        if (string.IsNullOrEmpty(Settings.DownloadPath))
        {
            ShowDownloadPathError = true;
            return;
        }

        ShowDownloadPathError = false;

        SettingsHelper.SaveSettings(Settings);

        await DownloadPathModal.HideAsync();
    }

    private void ToggleStopMark(EpisodeDownloadModel downloadEpisode)
    {
        if (RuntimeState.StopMarkDownload?.Download == downloadEpisode.Download)
        {
            RuntimeState.StopMarkDownload = null;
            ToastService.AddMessage(InfoMessage.StopmarkUnset, MessageType.Secondary);
            return;
        }

        RuntimeState.StopMarkDownload = new EpisodeDownloadModel
        {
            Download = downloadEpisode.Download,
            HasStopMark = true
        };

        ToastService.AddMessage(InfoMessage.StopmarkSet, MessageType.Secondary);
    }

    private static string FormatETA(TimeSpan eta)
    {
        return $"{eta.Hours:00}:{eta.Minutes:00}:{eta.Seconds:00}";
    }

    private BootstrapIcon GetDownloadResolutionIcon(VideoFileInfoModel videoFileInfo)
    {
        return videoFileInfo.VideoResolution switch
        {
            VideoResolution.P1080 => BootstrapIcon.BadgeHdFill,
            VideoResolution.P720 => BootstrapIcon.BadgeHdFill,
            VideoResolution.P480 => BootstrapIcon.BadgeSdFill,
            _ => BootstrapIcon.DiamondFill
        };
    }

    private ThemeColor GetDownloadResolutionIconColor(VideoFileInfoModel videoFileInfo)
    {
        return videoFileInfo.VideoResolution switch
        {
            VideoResolution.P1080 | VideoResolution.P720 => ThemeColor.Success,
            VideoResolution.P480 => ThemeColor.Light,
            _ => ThemeColor.Danger
        };
    }

    public void Dispose()
    {
        RuntimeState.StateChanged -= CronJobEvent;
        RuntimeState.ErrorOccurred -= CronJobErrorEvent;
        RuntimeState.DownloadsChanged -= CronJobDownloads;
        ConverterService.ConvertProgressChanged -= Converter_ConvertProgressChanged;
        ConverterService.ConverterStateChanged -= Converter_ConverterStateChanged;

        if (TmNextCycle is not null)
        {
            TmNextCycle.Elapsed -= RefreshCycleTime;
            TmNextCycle.Dispose();
        }
    }
}
