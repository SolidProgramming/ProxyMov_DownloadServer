@using System.Timers
@using ProxyMov_DownloadServer.I18nText
@using Toolbelt.Blazor.I18nText
@using Updater.Components
@using Updater.Interfaces
@using Routes = ProxyMov_DownloadServer.Misc.Routes;
@attribute [Route(Routes.Dashboard)]
@attribute [Route(Routes.Index)]
@inject IHxMessengerService ToastService
@inject ILogger<DashboardPage> DashboardLogger
@inject ILogger<CronJob> CronJobLogger
@inject IConverterService CS
@inject NavigationManager NavigationManager
@inject IQuartzService QuartzService
@inject I18nText I18nText
@inject IUpdateService UpdateService
@inject CronJob CronJobService
@inject DownloadRuntimeState RuntimeState

<PageTitle>Dashboard</PageTitle>

@if (Environment.GetEnvironmentVariable("DOTNET_RUNNING_IN_CONTAINER") != "true")
{
    <UpdateComponent></UpdateComponent>
}
<HxModal ShowCloseButton="false" CloseOnEscape="false" Size="ModalSize.Large" @ref="DownloadPathModal" Centered="true">
    <BodyTemplate>
        <div class="container">
            <HxAlert Color="ThemeColor.Info" CssClass="mt-1">
                <HxIcon CssClass="pe-1" Icon="@BootstrapIcon.ExclamationCircleFill" />
                Du hast noch keinen Download Pfad angegeben! <br /><span class="ps-4">Bitte trage hier den Pfad ein wo die Dateien gespeichert werden sollen.</span>
            </HxAlert>
            @if (ShowDownloadPathError)
            {
                <HxAlert Color="ThemeColor.Danger" CssClass="mt-1">
                    <HxIcon CssClass="pe-1" Icon="@BootstrapIcon.ExclamationCircleFill" />
                    Du musst einen Download Pfad angeben!
                </HxAlert>
            }
            <div class="mt-4">
                <HxInputText @bind-Value="Settings.DownloadPath" Placeholder="C:\\Downloads"></HxInputText>
            </div>
            <div class="mt-4">
                <HxButton OnClick="SaveDownloadPath" Color="ThemeColor.Success" Icon="BootstrapIcon.Check"
                          CssClass="w-100">
                    Speichern
                </HxButton>
            </div>
        </div>
    </BodyTemplate>
</HxModal>
<HxModal ShowCloseButton="false" CloseOnEscape="false" Size="ModalSize.Large" @ref="CaptchaModal" Centered="true">
    <BodyTemplate>
        <div class="container">
            <HxAlert Color="ThemeColor.Warning" CssClass="mt-2">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                    <div>
                        <HxIcon CssClass="pe-1" Icon="@BootstrapIcon.ExclamationTriangleFill" />
                        Captcha erkannt. Bitte Link im Browser öffnen, Captcha lösen und danach fortsetzen:
                        <a href="@RuntimeState.PendingCaptchaUrl" target="_blank">@RuntimeState.PendingCaptchaUrl</a>
                    </div>
                    <HxButton Color="ThemeColor.Success" Icon="BootstrapIcon.PlayFill" OnClick="ContinueAfterCaptcha">
                        Captcha gelöst, fortsetzen
                    </HxButton>
                </div>
            </HxAlert>
        </div>
    </BodyTemplate>
</HxModal>
<div class="container-lg">
    <div class="d-none d-md-block mt-4">
        <div style="overflow-y: auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        <th scope="col" class="text-center" style="font-family: 'Roboto', sans-serif;">Status</th>
                        <th scope="col" class="text-center" style="font-family: 'Roboto', sans-serif;">Name</th>
                        <th scope="col" class="text-center"
                            style="font-family: 'Roboto', sans-serif;">@LangText["Season"]</th>
                        <th scope="col" class="text-center" style="font-family: 'Roboto', sans-serif;">Episode</th>
                        <th scope="col" class="text-center"></th>
                        <th scope="col" class="text-center" style="font-family: 'Roboto', sans-serif;">%</th>
                        <th scope="col" class="text-center text-warning" style="font-family: 'Roboto', sans-serif;">
                            <HxIcon Icon="BootstrapIcon.LightningChargeFill" />
                        </th>
                        <th scope="col" class="text-center text-info" style="font-family: 'Roboto', sans-serif;">ETA</th>
                        <th scope="col"></th>
                        <th scope="col"></th>
                        <th scope="col" class="text-center"></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        IReadOnlyList<ActiveDownloadModel?> displayedDownloads = DisplayedDownloads;
                        bool isFirstRow = true;
                    }
                    @foreach (ActiveDownloadModel? download in displayedDownloads)
                    {
                        EpisodeDownloadModel? downloadEpisode = download?.Episode;
                        ConvertProgressModel? convertProgress = download?.Progress;

                        <tr @key="download?.Id">
                            <td class="text-center align-middle" width="50">
                                @if (downloadEpisode is not null)
                                {
                                    bool hasStopMark = downloadEpisode.Download == RuntimeState.StopMarkDownload?.Download;

                                    <HxButton OnClick="@(() => ToggleStopMark(downloadEpisode))"
                                              Color="@(hasStopMark ? ThemeColor.Info : ThemeColor.Secondary)"
                                              Icon="@(hasStopMark ? BootstrapIcon.FlagFill : BootstrapIcon.Flag)"></HxButton>
                                }
                            </td>
                            <td class="text-center align-middle" width="50">
                                @if (download is not null || CronJobState != CronJobState.WaitForNextCycle)
                                {
                                    <HxSpinner Color="ThemeColor.Secondary" Size="SpinnerSize.Small"></HxSpinner>
                                }
                                else
                                {
                                    <HxIcon Icon="BootstrapIcon.Hourglass"></HxIcon>
                                }
                            </td>
                            <td class="text-center align-middle" width="500" style="font-family: 'Roboto', sans-serif;">
                                @if (downloadEpisode is not null)
                                {
                                    <div class="row my-2">
                                        <span class="align-middle fw-semibold">@downloadEpisode.Download.Name</span>
                                    </div>
                                    <div class="d-flex justify-content-center">
                                        <HxBadge CssClass="mx-1 py-2 px-3" Type="BadgeType.Regular" Color="GetDownloadResolutionIconColor(downloadEpisode.VideoFileInfo)">
                                            <h5 class="d-inline align-middle fw-semibold">
                                                <HxIcon Icon="BootstrapIcon.BadgeHdFill"></HxIcon>
                                                <span>@downloadEpisode.VideoFileInfo.Resolution</span>
                                            </h5>
                                        </HxBadge>
                                        <HxBadge CssClass="mx-1 py-2 px-3" Type="BadgeType.Regular" Color="GetDownloadResolutionIconColor(downloadEpisode.VideoFileInfo)">
                                            <h5 class="d-inline align-middle fw-semibold">
                                                <HxIcon Icon="BootstrapIcon.Nvidia"></HxIcon>
                                                <span>@downloadEpisode.VideoFileInfo.VideoCodec</span>
                                            </h5>
                                        </HxBadge>
                                        <HxBadge CssClass="mx-1 py-2 px-3" Type="BadgeType.Regular" Color="GetDownloadResolutionIconColor(downloadEpisode.VideoFileInfo)">
                                            <h5 class="d-inline align-middle fw-semibold">
                                                <HxIcon Icon="BootstrapIcon.Soundwave"></HxIcon>
                                                <span>@downloadEpisode.VideoFileInfo.AudioCodec</span>
                                            </h5>
                                        </HxBadge>
                                    </div>
                                }
                                else
                                {
                                    <HxIcon Icon="BootstrapIcon.Dash"></HxIcon>
                                }
                            </td>
                            <td class="text-center align-middle" width="70" style="font-family: 'Roboto', sans-serif;">
                                @if (downloadEpisode is not null)
                                {
                                    @($"S{downloadEpisode.Download.Season:D2}")
                                }
                                else
                                {
                                    <HxIcon Icon="BootstrapIcon.Dash"></HxIcon>
                                }
                            </td>
                            <td class="text-center align-middle" width="70" style="font-family: 'Roboto', sans-serif;">
                                @if (downloadEpisode is not null)
                                {
                                    @($"E{downloadEpisode.Download.Episode:D2}")
                                }
                                else
                                {
                                    <HxIcon Icon="BootstrapIcon.Dash"></HxIcon>
                                }
                            </td>
                            <td class="text-center align-middle" width="90">
                                @if (download is not null)
                                {
                                    <LanguageFlagComponent Languages="@download.Language"></LanguageFlagComponent>
                                }
                                else
                                {
                                    <HxIcon Icon="BootstrapIcon.Dash"></HxIcon>
                                }
                            </td>
                            <td class="text-center align-middle" width="220">
                                <HxProgress>
                                    <HxProgressBar Value="@(convertProgress?.ProgressPercent ?? 0)" Color="ThemeColor.Success" />
                                </HxProgress>
                            </td>
                            <td class="text-center align-middle" width="70">
                                @if (convertProgress is not null)
                                {
                                    @(GetAdjustedDownloadSpeed(convertProgress))
                                }
                                else
                                {
                                    <HxIcon Icon="BootstrapIcon.Dash"></HxIcon>
                                }
                            </td>
                            <td class="text-center align-middle" width="100" style="font-family: 'Roboto', sans-serif;">
                                @if (convertProgress is not null && download!.SmoothedETA.TotalSeconds > 0)
                                {
                                    @FormatETA(download.SmoothedETA)
                                }
                                else
                                {
                                    <HxIcon Icon="BootstrapIcon.Dash"></HxIcon>
                                }
                            </td>
                            @if (isFirstRow)
                            {
                                <td class="text-center align-middle" width="50" rowspan="@displayedDownloads.Count">
                                    <HxButton Enabled="@(ActiveDownloads.Count > 0 && StopConverterButtonEnabled)"
                                              Color="ThemeColor.Warning" Icon="BootstrapIcon.StopFill"
                                              OnClick="StopConverter"></HxButton>
                                </td>
                            }
                            <td class="text-center align-middle" width="50">
                                <HxButton OnClick="@(() => SkipDownload(download))" Color="ThemeColor.Secondary"
                                          Enabled="@(download is not null)"
                                          Icon="BootstrapIcon.SkipForwardFill"></HxButton>
                            </td>
                            @if (isFirstRow)
                            {
                                <td class="text-center align-middle" width="50" rowspan="@displayedDownloads.Count">
                                    <HxButton Spinner="CheckDownloadsButtonSpinner" Enabled="CheckDownloadsButtonEnabled"
                                              OnClick="CheckForDownloads" Color="ThemeColor.Success"
                                              Icon="BootstrapIcon.ArrowClockwise"></HxButton>
                                </td>
                            }
                        </tr>

                        isFirstRow = false;
                    }
                </tbody>
            </table>
        </div>
    </div>
